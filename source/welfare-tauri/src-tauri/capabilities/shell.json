{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "shell-allow-sidecar",
    "description": "Allow sidecar execution",
    "windows": [
        "main"
    ],
    "permissions": [
        {
            "identifier": "shell:allow-execute",
            "allow": [
                {
                    "name": "api-server",
                    "sidecar": true,
                    "args": []
                },
                {
                    "name": "api-server-prod",
                    "cmd": "api-server.exe",
                    "args": []
                }
            ]
        }
    ]
}