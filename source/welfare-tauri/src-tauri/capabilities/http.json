{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "http-capability",
    "description": "Allow HTTP requests through Tauri native networking",
    "windows": [
        "main"
    ],
    "permissions": [
        "http:default",
        {
            "identifier": "http:default",
            "allow": [
                {
                    "url": "http://localhost:8421/*"
                },
                {
                    "url": "http://127.0.0.1:8421/*"
                }
            ]
        }
    ]
}